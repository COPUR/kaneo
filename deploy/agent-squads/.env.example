# Generate with: openssl rand -hex 32
AUTH_SECRET=
POSTGRES_PASSWORD=
KANEO_CLIENT_URL=http://localhost:5173
KANEO_PORT=5173

# Used by seed.mjs. The first account becomes the instance admin and the
# product owner of the tribe workspace.
KANEO_OWNER_EMAIL=po@example.com
KANEO_OWNER_PASSWORD=
KANEO_OWNER_NAME="Product Owner"

# Slack listener agent (slack/README.md). Leave empty to not use Slack.
# Never commit these; .env is git-ignored.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Board for requests that name no squad, repository or decision.
SLACK_DEFAULT_BOARD=PLT
# Channel ids where every top-level message becomes a card (else mentions and DMs only).
SLACK_CARD_CHANNELS=
# Channel ids with their own board, e.g. C0123=CON,C0456=TEL
SLACK_CHANNEL_BOARDS=
